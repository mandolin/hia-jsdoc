{
  "plugins": [
    "../jsdoc-plugin-hia-sys/src/index.cjs"
  ],
  "source": {
    "include": [
      "packages/jsdoc-doc-source-map/src",
      "packages/jsdoc-extra-plugin-registry/src",
      "packages/jsdoc-plugin-hia-bridge/src",
      "packages/jsdoc-preset/src",
      "packages/jsdoc-producer/src",
      "packages/jsdoc-runner/src",
      "packages/jsdoc-spec/src",
      "packages/jsdoc-theme-bridge/src"
    ],
    "includePattern": ".+\\.mjs$",
    "excludePattern": "(^|[/\\\\])_"
  },
  "opts": {
    "destination": "fixtures/self-doc/out",
    "recurse": true,
    "hia": {
      "mode": "standalone",
      "source": {
        "basePath": ".",
        "mode": "all",
        "link": {
          "enabled": true,
          "rootUrl": "",
          "openMode": "same-tab"
        },
        "preview": {
          "enabled": true,
          "defaultExpanded": false
        },
        "references": {
          "enabled": true,
          "defaultExpanded": false
        }
      },
      "i18n": {
        "enabled": true,
        "defaultLocale": "en",
        "fallbackLocale": "en",
        "locales": [
          "en",
          "zh-CN"
        ],
        "mode": "runtimeSwitch",
        "resources": []
      },
      "presentation": {
        "pageMode": "multi-page",
        "sourceMode": "fetch"
      },
      "theme": {
        "skin": "classic",
        "scheme": "system",
        "collapse": {
          "docletsDefaultExpanded": true,
          "sectionsDefaultExpanded": true,
          "metadataDefaultExpanded": true
        },
        "languageControls": {
          "mode": "auto",
          "dropdownThreshold": 4
        },
        "code": {
          "controls": true,
          "fontFamily": "sarasa",
          "fontSize": 12,
          "lineHeight": 1.55,
          "tabSize": 2,
          "wrap": false
        }
      },
      "integration": {
        "enabled": true,
        "outputFile": "fixtures/self-doc/out/hia-integration.json"
      },
      "umbrella": {
        "contract": "hia-jsdoc-umbrella-config",
        "contractVersion": "0.1.0-draft",
        "versions": {
          "contract": "hia-jsdoc-umbrella-config",
          "contractVersion": "0.1.0-draft",
          "jsdoc": {
            "package": "jsdoc",
            "version": "4.0.5"
          },
          "plugin": {
            "package": "@mandolin/jsdoc-plugin-hia-sys",
            "version": "0.1.0"
          },
          "theme": {
            "package": "@mandolin/jsdoc-theme-hia",
            "version": "0.1.0"
          }
        },
        "themeBridge": {
          "package": "@mandolin/jsdoc-theme-hia",
          "version": "0.1.0",
          "template": "../jsdoc-theme-hia",
          "enabled": true,
          "presentation": {
            "contract": "documentation-presentation-profile",
            "contractVersion": "0.1.0-draft",
            "pageMode": "multi-page",
            "sourceMode": "fetch",
            "skinId": "classic",
            "scheme": "system",
            "skinCatalog": {
              "ownerPackage": "@mandolin/jsdoc-theme-hia",
              "projection": "documentation-presentation-profile.theme.skins"
            }
          }
        },
        "extraPluginDiagnostics": []
      }
    },
    "template": "../jsdoc-theme-hia"
  }
}
